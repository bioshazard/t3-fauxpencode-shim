{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "corpusId", "generatedFrom", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "corpusId": { "type": "string", "minLength": 1 },
    "generatedFrom": {
      "type": "object",
      "required": ["t3CodeCommit", "openCodeCommit"],
      "properties": {
        "t3CodeCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "openCodeCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      },
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "operation",
          "transport",
          "method",
          "path",
          "support",
          "sources"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^OC-(HTTP|SSE|CLI)-[0-9]{4}$" },
          "category": { "type": "string", "minLength": 1 },
          "operation": { "type": "string", "minLength": 1 },
          "transport": { "enum": ["http", "sse", "process"] },
          "method": { "type": "string", "minLength": 1 },
          "path": { "type": ["string", "null"] },
          "support": { "enum": ["required", "conditional", "excluded"] },
          "requestFields": { "type": "array", "items": { "type": "string" } },
          "eventTypes": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["repository", "path", "line", "symbol"],
              "properties": {
                "repository": { "type": "string", "format": "uri" },
                "path": { "type": "string", "minLength": 1 },
                "line": { "type": "integer", "minimum": 1 },
                "symbol": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "corpusId", "status", "rows"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "corpusId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["pending-reference-capture", "frozen"] },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "scenario",
          "operation",
          "trigger",
          "request",
          "response",
          "events",
          "stateEffect",
          "errorBehavior",
          "normalization",
          "evidence",
          "confidence",
          "support"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "scenario": { "type": "string", "pattern": "^C[0-9]{2}$" },
          "operation": { "type": "string", "minLength": 1 },
          "trigger": { "type": "string", "minLength": 1 },
          "request": { "type": "object" },
          "response": { "type": "object" },
          "events": { "type": "array" },
          "stateEffect": { "type": "object" },
          "errorBehavior": { "type": "string", "minLength": 1 },
          "normalization": { "type": "array" },
          "evidence": { "type": "array", "minItems": 1 },
          "confidence": {
            "enum": ["observed", "source-confirmed", "hypothesis"]
          },
          "support": { "enum": ["required", "conditional", "excluded"] },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

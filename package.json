{
  "name": "pi-opencode-shim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/server.ts",
    "start": "bun run src/server.ts",
    "test": "bun test",
    "build": "bun build src/server.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "contract:inventory": "bun run tools/contract/inventory.ts",
    "contract:matrix": "bun run tools/contract/matrix.ts",
    "contract:capture": "bun run tools/contract/capture.ts",
    "contract:reference": "bun run tools/contract/reference.ts",
    "contract:reference-verify": "bun run tools/contract/reference-verify.ts",
    "contract:acceptance": "bun run tools/contract/acceptance.ts",
    "contract:record": "bun run tools/contract/record.ts",
    "contract:scenarios": "bun run tools/contract/scenarios.ts",
    "t3:shim": "bash tools/run-t3-shim.sh",
    "t3:shim:source": "T3_ROOT=/tmp/poc-opencode-pi-shim-t3code-pinned bun run t3:shim",
    "dev:local": "bunx pm2@7.0.4 start ecosystem.config.cjs",
    "stop:local": "bunx pm2@7.0.4 delete ecosystem.config.cjs",
    "logs:local": "bunx pm2@7.0.4 logs",
    "test:e2e": "playwright test",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.80.0",
    "@playwright/test": "1.62.1",
    "@types/bun": "1.4.0",
    "lefthook": "2.1.12",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "7.0.2",
    "ultracite": "7.10.7"
  },
  "packageManager": "bun@1.2.17"
}
